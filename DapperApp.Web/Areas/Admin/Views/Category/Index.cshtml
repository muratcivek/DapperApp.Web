@model IEnumerable<DapperApp.Web.DTOs.Categories.ResultCategoryDto>

@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "_Layout";

    var categories = Model?.ToList()
        ?? new List<DapperApp.Web.DTOs.Categories.ResultCategoryDto>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Kategori Listesi</h3>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Create"
           class="btn btn-success">
            + Yeni Kategori
        </a>
    </div>

    <div class="alert alert-info">
        Toplam Kategori Sayısı:
        <strong>@categories.Count</strong>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Kategori ID</th>
                <th>Kategori Adı</th>
                <th style="width: 200px;">İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @if (categories.Any())
            {
                int rowNumber = 1;

                foreach (var item in categories)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@item.CategoryId</td>
                        <td>@item.Name</td>
                        <td>
                            <a asp-area="Admin"
                               asp-controller="Category"
                               asp-action="Update"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-warning btn-sm">
                                Güncelle
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="Category"
                                  asp-action="Delete"
                                  asp-route-id="@item.CategoryId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Sil
                                </button>
                            </form>
                        </td>
                    </tr>

                    rowNumber++;
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Kayıtlı kategori bulunamadı.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>