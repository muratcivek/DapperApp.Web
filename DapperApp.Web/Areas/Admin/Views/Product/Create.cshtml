@model CreateProductDto

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    Layout = "_Layout";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Yeni Ürün Ekle</h3>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="btn btn-secondary">
            Ürün Listesine Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            Ürün Bilgileri
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Product"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">
                            Ürün Adı
                        </label>
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Ürün adını giriniz" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">
                            Kategori
                        </label>
                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">
                            <option value="">Kategori Seçiniz</option>
                        </select>
                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">
                            Fiyat
                        </label>
                        <input asp-for="Price"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control" />
                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stock" class="form-label">
                            Stok Miktarı
                        </label>
                        <input asp-for="Stock"
                               type="number"
                               min="0"
                               class="form-control" />
                        <span asp-validation-for="Stock"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label">
                            Ürün Görsel URL
                        </label>
                        <input asp-for="ImageUrl"
                               class="form-control"
                               placeholder="https://example.com/image.jpg" />
                        <span asp-validation-for="ImageUrl"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive"
                                   class="form-check-input" />
                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Ürün Aktif
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        İptal
                    </a>

                    <button type="submit" class="btn btn-success">
                        Ürünü Kaydet
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
